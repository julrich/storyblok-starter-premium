# Secrets defined here are available for reference under registry/password, env/secret, builder/secrets,
# and accessories/*/env/secret in config/deploy-*.yml. All secrets should be pulled from either
# password manager, ENV, or a file. DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.

# Option 1: Read secrets from the environment
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
MCP_JWT_SECRET=$MCP_JWT_SECRET

# Website secrets (config/deploy-website.yml)
NEXT_STORYBLOK_API_TOKEN=$NEXT_STORYBLOK_API_TOKEN
NEXT_STORYBLOK_OAUTH_TOKEN=$NEXT_STORYBLOK_OAUTH_TOKEN
NEXT_STORYBLOK_SPACE_ID=$NEXT_STORYBLOK_SPACE_ID
NEXT_OPENAI_API_KEY=$NEXT_OPENAI_API_KEY

# MCP server secrets (config/deploy-storyblok-mcp.yml)
STORYBLOK_API_TOKEN=$STORYBLOK_API_TOKEN
STORYBLOK_OAUTH_TOKEN=$STORYBLOK_OAUTH_TOKEN
STORYBLOK_SPACE_ID=$STORYBLOK_SPACE_ID
OPENAI_API_KEY=$OPENAI_API_KEY

# Sharepoint folder picker plugin
AZURE_TENANT_ID=$AZURE_TENANT_ID
AZURE_CLIENT_ID=$AZURE_CLIENT_ID
AZURE_CLIENT_SECRET=$AZURE_CLIENT_SECRET

# Analytics / Umami secrets (config/deploy-umami-analytics.yml)
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
DATABASE_URL=postgresql://kamal_pg:$POSTGRES_PASSWORD@postgres:5432/kamal_pg_production
DATABASE_TYPE=postgresql

