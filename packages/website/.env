# Primary is the canonical host; secondary is permanently redirected to it
# (see `redirects()` in next.config.js). drhubert.de -> www.drhubert.de
NEXT_PUBLIC_PRIMARY_PUBLIC_SITE_DOMAIN=www.drhubert.de
NEXT_PUBLIC_SECONDARY_PUBLIC_SITE_DOMAIN=drhubert.de
NEXT_PUBLIC_SITE_URL=https://${NEXT_PUBLIC_PRIMARY_PUBLIC_SITE_DOMAIN}
# Analytics is hosted centrally by ruhmesmeile, so it is NOT derived from the
# site domain the way the upstream default does it.
NEXT_PUBLIC_ANALYTICS_DOMAIN=usage.ruhmesmeile.com
NEXT_PUBLIC_ANALYTICS_SITE_ID=3dd1b8bb-e68e-4f87-b45a-130605c8b4a2
DOCKER_USERNAME=ruhmesmeile
DOCKER_SITE_IMAGE_NAME=ruhmesmeile/hubert-website
DOCKER_BUILDKIT=1
HOSTING_SERVER_IP=91.98.139.222
